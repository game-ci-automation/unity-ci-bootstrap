# Unity CI Enabler — Common environment (cloud-agnostic)
# Copy this file to .env and fill in values.
# Cloud-specific values live in .env.azure / .env.gcp (see their .example files),
# maintained by scripts/azure/sync-env.sh and scripts/gcp/sync-env.sh.

REPO_URL=                           # build target repo
PLATFORM=                           # WebGL | Android | iOS | StandaloneLinux64 | StandaloneWindows64
ADMIN_PASSWORD=                     # bootstrap VM desktop login password
GITHUB_TOKEN=                       # optional GitHub PAT — empty for public repos, required for private
                                    # (used by downloader version detection; Azure legacy webhook flow also uses it)
